---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { useTranslations, locales } from "../../i18n/utils";
import type { Lang } from "../../i18n/ui";
import { researchAreas } from "../../data/research";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} title={t("research.title")}>
  <section class="section wrap">
    <p class="cmd-head"><span class="pfx">trex:~$</span> cat research/*</p>
    <p class="intro out">{t("research.intro")}</p>

    <ol class="index areas">
      {
        researchAreas.map((area, i) => (
          <li class="area row">
            <span class="num">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <h3 class="area-title">
                {lang === "tr" ? area.title_tr : area.title_en}
              </h3>
              <p class="muted">
                {lang === "tr" ? area.desc_tr : area.desc_en}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>

<style>
  .intro {
    font-size: 1.05rem;
    line-height: 1.7;
    margin-top: 0.8rem;
    max-width: 60ch;
  }
  .areas {
    margin-top: 2.5rem;
  }
  .area {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.3rem 1rem;
    align-items: baseline;
  }
  .num {
    color: var(--accent);
    font-weight: 700;
  }
  .area-title {
    font-size: 1.15rem;
  }
  .area p {
    margin-top: 0.4rem;
    max-width: 62ch;
    font-size: 0.95rem;
    line-height: 1.6;
  }
  @media (max-width: 480px) {
    .area {
      grid-template-columns: 2rem 1fr;
    }
  }
</style>
