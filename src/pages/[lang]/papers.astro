---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PaperItem from "../../components/PaperItem.astro";
import { useTranslations, locales } from "../../i18n/utils";
import type { Lang } from "../../i18n/ui";

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
const t = useTranslations(lang);

const papers = await getCollection("papers");
// Group by year, newest first.
const byYear = new Map<number, typeof papers>();
for (const p of papers.sort((a, b) => b.data.year - a.data.year)) {
  const arr = byYear.get(p.data.year) ?? [];
  arr.push(p);
  byYear.set(p.data.year, arr);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
---

<BaseLayout lang={lang} title={t("papers.title")}>
  <section class="section wrap">
    <p class="cmd-head"><span class="pfx">trex.ai:~$</span> ls -lt papers/</p>
    {
      years.map((year) => (
        <div class="year-block">
          <h2 class="year">// {year}</h2>
          {byYear.get(year)!.map((paper) => (
            <PaperItem paper={paper} lang={lang} />
          ))}
        </div>
      ))
    }
  </section>
</BaseLayout>

<style>
  .page-title {
    margin-top: 0.4rem;
    margin-bottom: 1rem;
  }
  .year-block {
    margin-top: 2.5rem;
  }
  .year {
    font-family: var(--font-mono);
    font-weight: 700;
    text-transform: uppercase;
    color: var(--accent-ink);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
  }
</style>
