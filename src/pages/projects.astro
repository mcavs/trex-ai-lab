---
import BaseLayout from "../layouts/BaseLayout.astro";
import { useTranslations, locales } from "../i18n/utils";
import type { Lang } from "../i18n/ui";
import { projects } from "../data/projects";


const lang = "en" as const;
const t = useTranslations(lang);
const tr = lang === "tr";
---

<BaseLayout lang={lang} title={t("projects.title")}>
  <section class="section wrap">
    <p class="cmd-head"><span class="pfx">trex.ai:~$</span> cat projects/*</p>
    <p class="intro out">{t("projects.intro")}</p>

    <div class="projects-list">
      {
        projects.map((proj, i) => (
          <article class="project-card">
            <header class="project-header">
              <div class="proj-badge-row">
                <span class="num">{String(i + 1).padStart(2, "0")}</span>
                {proj.code && <span class="badge code">{proj.code}</span>}
                <span class="badge status">{tr ? proj.status_tr : proj.status_en}</span>
                <span class="badge type">{tr ? proj.type_tr : proj.type_en}</span>
              </div>
              <h2 class="project-title">
                {tr ? proj.title_tr : proj.title_en}
              </h2>
              {(proj.funding_tr || proj.funding_en) && (
                <p class="funding-meta">
                  <span class="meta-label">{t("projects.grant")}:</span> {tr ? proj.funding_tr : proj.funding_en}
                </p>
              )}
            </header>

            <div class="project-body">
              {(tr ? proj.desc_tr : proj.desc_en).split("\n\n").map((para) => (
                <p>{para}</p>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .intro {
    font-size: 1.05rem;
    line-height: 1.7;
    margin-top: 0.8rem;
    max-width: 65ch;
  }
  .projects-list {
    margin-top: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }
  .project-card {
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: clamp(1.2rem, 3vw, 2rem);
    background: var(--bg-2, rgba(255, 255, 255, 0.02));
  }
  .proj-badge-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 0.8rem;
  }
  .num {
    color: var(--accent);
    font-weight: 700;
    font-size: 1.1rem;
    margin-right: 0.2rem;
  }
  .badge {
    font-size: 0.78rem;
    font-family: var(--font-mono);
    padding: 0.15rem 0.55rem;
    border-radius: 3px;
    border: 1px solid var(--line-strong);
  }
  .badge.code {
    background: var(--line);
    color: var(--accent);
    font-weight: 700;
  }
  .badge.status {
    color: #4ade80;
    border-color: rgba(74, 222, 128, 0.3);
  }
  .badge.type {
    color: var(--text-muted);
  }
  .project-title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.45;
    color: var(--text);
  }
  .funding-meta {
    font-size: 0.88rem;
    color: var(--text-muted);
    margin-top: 0.5rem;
    font-family: var(--font-mono);
  }
  .meta-label {
    color: var(--accent);
  }
  .project-body {
    margin-top: 1.2rem;
    border-top: 1px dashed var(--line);
    padding-top: 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
    white-space: pre-line;
  }
</style>
