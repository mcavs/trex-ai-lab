---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { useTranslations, localizedUrl } from "../../i18n/utils";
import { blogLang, blogSlug, blogHref } from "../../lib/content";
import type { Lang } from "../../i18n/ui";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { lang: blogLang(post), slug: blogSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const lang = "en" as const;
const t = useTranslations(lang);
const d = post.data;

const { Content } = await render(post);

// Author
const team = await getCollection("team");
const author = team.find((m) => m.id === d.author.id);

// Reading time (~200 wpm)
const words = post.body?.split(/\s+/).filter(Boolean).length ?? 0;
const minutes = Math.max(1, Math.round(words / 200));

// Translation in the other language (same translationId)
const otherLang: Lang = lang === "en" ? "tr" : "en";
let translation = null;
if (d.translationId) {
  const all = await getCollection("blog");
  translation =
    all.find(
      (p) => p.data.translationId === d.translationId && blogLang(p) === otherLang
    ) ?? null;
}

const dateFmt = new Intl.DateTimeFormat(lang === "tr" ? "tr-TR" : "en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(d.pubDate);
---

<BaseLayout
  lang={lang}
  title={d.title}
  description={d.description}
  ogType="article"
  image={d.cover ? d.cover.src : undefined}
>
  <article class="section">
    <div class="container post-head">
      <a class="back" href={localizedUrl(lang, "blog")}>{t("blog.backToBlog")}</a>
      <div class="tags">{d.tags.map((tag) => <span class="chip">{tag}</span>)}</div>
      <h1>{d.title}</h1>
      <p class="lede muted">{d.description}</p>
      <p class="byline muted">
        <time datetime={d.pubDate.toISOString()}>{dateFmt}</time>
        {author && <> · {t("blog.by")} {author.data.name}</>}
        · {minutes} {t("blog.readingTime")}
      </p>

      {
        translation && (
          <p class="translation">
            {t("blog.readIn")}{" "}
            <a href={blogHref(translation)}>
              {otherLang === "tr" ? "Türkçe" : "English"}
            </a>
          </p>
        )
      }
    </div>

    {
      d.cover && (
        <div class="container">
          <Image src={d.cover} alt={d.title} width={1100} height={600} class="cover" />
        </div>
      )
    }

    <div class="container">
      <div class="prose has-notes post-body">
        <Content />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .post-head {
    max-width: 75ch;
  }
  .back {
    font-family: var(--font-mono);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.74rem;
    text-decoration: none;
    color: var(--text-muted);
  }
  .back:hover {
    color: var(--accent-ink);
  }
  h1 {
    margin-top: 1rem;
  }
  .tags {
    display: flex;
    gap: 0.8rem;
    margin: 1.2rem 0 0.5rem;
    flex-wrap: wrap;
  }
  .lede {
    font-size: clamp(1.2rem, 2.2vw, 1.55rem);
    line-height: 1.45;
    color: var(--text-muted);
    margin-top: 1.2rem;
    max-width: 56ch;
  }
  .byline {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.74rem;
    color: var(--text-muted);
    margin-top: 1.4rem;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .translation {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.76rem;
    margin-top: 0.8rem;
  }
  .cover {
    width: 100%;
    height: auto;
    max-height: 520px;
    object-fit: cover;
    border: 1px solid var(--line-strong);
    margin-block: 2.5rem;
    filter: grayscale(1) contrast(1.08);
  }
  .post-body {
    margin-top: 1rem;
  }
</style>
