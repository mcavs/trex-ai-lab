---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import type { Lang } from "../i18n/ui";

interface Props {
  member: CollectionEntry<"team">;
  lang: Lang;
}
const { member, lang } = Astro.props;
const d = member.data;
const role = lang === "tr" ? d.role_tr : d.role_en;
const bio = lang === "tr" ? d.bio_tr : d.bio_en;
const l = d.links ?? {};
const projects = d.projects ?? [];
const papers = d.papers ?? [];
---

<article class="card member">
  <div class="avatar-frame">
    <Image
      src={d.photo}
      alt={d.name}
      width={400}
      height={500}
      densities={[1, 2]}
      class="avatar"
    />
  </div>
  <div class="body">
    <h3 class="name">{d.name}</h3>
    <p class="role">{role}</p>
    <p class="bio muted">{bio}</p>

    {projects.length > 0 && (
      <div class="badge-block">
        <span class="badge-title">// {lang === "tr" ? "projeler" : "projects"}</span>
        <div class="badge-list">
          {projects.map((p) => (
            p.href ? (
              <a href={p.href} class="badge project-badge" target="_blank" rel="noopener">
                <span class="b-code">{p.code}</span>
                {p.label && <span class="b-label">{p.label}</span>}
              </a>
            ) : (
              <span class="badge project-badge">
                <span class="b-code">{p.code}</span>
                {p.label && <span class="b-label">{p.label}</span>}
              </span>
            )
          ))}
        </div>
      </div>
    )}

    {papers.length > 0 && (
      <div class="badge-block">
        <span class="badge-title">// {lang === "tr" ? "yayınlar" : "papers"}</span>
        <div class="badge-list">
          {papers.map((p) => (
            p.href ? (
              <a href={p.href} class="badge paper-badge" target="_blank" rel="noopener">
                <span class="b-code">{p.code}</span>
                {p.label && <span class="b-label">{p.label}</span>}
              </a>
            ) : (
              <span class="badge paper-badge">
                <span class="b-code">{p.code}</span>
                {p.label && <span class="b-label">{p.label}</span>}
              </span>
            )
          ))}
        </div>
      </div>
    )}

    <div class="links">
      {l.website && <a href={l.website} target="_blank" rel="noopener" aria-label={`${d.name} website`}>Web</a>}
      {l.scholar && <a href={l.scholar} target="_blank" rel="noopener" aria-label={`${d.name} Google Scholar`}>Scholar</a>}
      {l.github && <a href={l.github} target="_blank" rel="noopener" aria-label={`${d.name} GitHub`}>GitHub</a>}
      {l.linkedin && <a href={l.linkedin} target="_blank" rel="noopener" aria-label={`${d.name} LinkedIn`}>LinkedIn</a>}
      {l.x && <a href={l.x} target="_blank" rel="noopener" aria-label={`${d.name} X`}>X</a>}
      {l.email && <a href={`mailto:${l.email}`} aria-label={`Email ${d.name}`}>Email</a>}
    </div>
  </div>
</article>

<style>
  .member {
    display: flex;
    flex-direction: column;
  }
  .avatar-frame {
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    overflow: hidden;
    background: var(--bg-2);
  }
  .avatar {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: grayscale(1) contrast(1.02) brightness(0.95) sepia(0.22);
    transition: filter 0.25s;
  }
  .member:hover .avatar {
    filter: none;
  }
  .body {
    padding: 0.8rem 0 0;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .name {
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.2;
  }
  .name::before {
    content: "● ";
    color: var(--accent);
    font-size: 0.7em;
    vertical-align: middle;
  }
  .role {
    display: block;
    color: var(--accent);
    font-size: 0.82rem;
    margin-top: 0.25rem;
  }
  .bio {
    font-size: 0.88rem;
    line-height: 1.5;
    margin-top: 0.6rem;
    color: var(--text-muted);
  }

  /* Badge Sections */
  .badge-block {
    margin-top: 0.75rem;
    padding-top: 0.55rem;
    border-top: 1px dashed var(--line);
  }
  .badge-title {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: var(--text-dim, #717888);
    margin-bottom: 0.4rem;
  }
  .badge-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    line-height: 1.2;
    padding: 0.22rem 0.5rem;
    border-radius: 3px;
    text-decoration: none;
    transition: transform 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }
  .project-badge {
    background: rgba(74, 151, 104, 0.1);
    border: 1px solid rgba(74, 151, 104, 0.35);
    color: #4a9768;
  }
  :root[data-theme="pink"] .project-badge {
    background: rgba(184, 69, 136, 0.1);
    border-color: rgba(184, 69, 136, 0.35);
    color: #b84588;
  }
  .paper-badge {
    background: rgba(184, 69, 136, 0.1);
    border: 1px solid rgba(184, 69, 136, 0.35);
    color: #b84588;
  }
  :root[data-theme="pink"] .paper-badge {
    background: rgba(74, 151, 104, 0.1);
    border-color: rgba(74, 151, 104, 0.35);
    color: #4a9768;
  }
  a.badge:hover {
    transform: translateY(-1px);
    border-color: currentColor;
    background: rgba(255, 255, 255, 0.06);
  }
  .b-code {
    font-weight: 700;
  }
  .b-label {
    opacity: 0.8;
    font-size: 0.9em;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    margin-top: auto;
    padding-top: 0.9rem;
  }
  .links a {
    font-size: 0.82rem;
    color: var(--accent-ink);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }
  .links a::before {
    content: "▸";
    color: var(--accent);
    margin-right: 0.25em;
  }
  .links a:hover {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
</style>
