---
import { localizedUrl, useTranslations } from "../i18n/utils";
import type { Lang, UIKey } from "../i18n/ui";
import LangToggle from "./LangToggle.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const nav: { key: UIKey; path: string }[] = [
  { key: "nav.team", path: "team" },
  { key: "nav.papers", path: "papers" },
  { key: "nav.blog", path: "blog" },
  { key: "nav.research", path: "research" },
  { key: "nav.contact", path: "contact" },
];

const current = Astro.url.pathname.replace(/\/$/, "");
function isActive(path: string) {
  const href = localizedUrl(lang, path).replace(/\/$/, "");
  if (path === "") return current === href;
  return current === href || current.startsWith(href + "/");
}
---

<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={localizedUrl(lang, "")} aria-label="Discern Lab — home">
      <span class="prompt">discern</span><span class="at">@</span><span class="host">lab</span><span class="prompt">:~$</span>
      <span class="brand-cursor" aria-hidden="true"></span>
    </a>

    <button
      class="menu-btn"
      id="menu-btn"
      type="button"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="primary-nav"
    >
      ☰ menu
    </button>

    <nav class="primary-nav" id="primary-nav" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={localizedUrl(lang, item.path)}
            class:list={["nav-link", { active: isActive(item.path) }]}
            aria-current={isActive(item.path) ? "page" : undefined}
          >
            {t(item.key)}
          </a>
        ))
      }
      <span class="nav-sep" aria-hidden="true"></span>
      <LangToggle lang={lang} />
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 90%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 60px;
    gap: 1.5rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.1rem;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 700;
    text-decoration: none;
    border-bottom: none;
  }
  .brand .prompt {
    color: var(--accent);
    text-shadow: var(--accent-glow);
  }
  .brand .at {
    color: var(--text-muted);
  }
  .brand .host {
    color: var(--text);
  }
  .brand-cursor {
    width: 0.55em;
    height: 1.05em;
    margin-left: 0.25rem;
    background: var(--accent);
    box-shadow: var(--accent-glow);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .brand-cursor {
      animation: none;
    }
  }
  .primary-nav {
    display: flex;
    align-items: center;
    gap: 1.3rem;
  }
  .nav-link {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--text-muted);
    text-decoration: none;
    border-bottom: none;
  }
  .nav-link::before {
    content: "";
    color: var(--accent);
  }
  .nav-link:hover {
    color: var(--accent);
  }
  .nav-link:hover::before {
    content: "› ";
    margin-left: -0.85em;
  }
  .nav-link.active {
    color: var(--text);
  }
  .nav-link.active::before {
    content: "› ";
    color: var(--accent);
    margin-left: -0.85em;
  }
  .nav-sep {
    width: 1px;
    height: 16px;
    background: var(--line-strong);
  }
  .menu-btn {
    display: none;
    height: 38px;
    padding-inline: 0.85rem;
    border: 1px solid var(--line-strong);
    border-radius: 4px;
    background: transparent;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    cursor: pointer;
  }
  .menu-btn[aria-expanded="true"] {
    border-color: var(--accent);
    color: var(--accent);
  }

  @media (max-width: 820px) {
    .menu-btn {
      display: inline-flex;
      align-items: center;
    }
    .primary-nav {
      position: fixed;
      inset: 60px 0 auto 0;
      flex-direction: column;
      align-items: flex-start;
      gap: 0;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
    }
    .primary-nav:not(.open) {
      display: none;
    }
    .nav-link {
      width: 100%;
      padding: 0.9rem clamp(1rem, 4vw, 3rem);
      border-top: 1px solid var(--line);
      font-size: 0.95rem;
    }
    .nav-sep {
      display: none;
    }
    .primary-nav :global(.lang-toggle) {
      margin: 0.9rem clamp(1rem, 4vw, 3rem);
    }
  }
</style>

<script is:inline>
  (function () {
    var btn = document.getElementById("menu-btn");
    var nav = document.getElementById("primary-nav");
    if (!btn || !nav) return;
    btn.addEventListener("click", function () {
      var open = nav.classList.toggle("open");
      btn.setAttribute("aria-expanded", open ? "true" : "false");
    });
  })();
</script>
